import React, { useState } from 'react';
import { BADGES, TIER_ORDER } from '@/lib/badges';
import BadgeCard from './BadgeCard';
import { Card } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Medal } from 'lucide-react';
import { cn } from '@/lib/utils';

const TIER_FILTERS = ['all', 'platinum', 'gold', 'silver', 'bronze'];

const tierBadgeStyle = {
  all:      'bg-secondary text-secondary-foreground',
  platinum: 'bg-violet-500/20 text-violet-300 border-violet-500/30',
  gold:     'bg-yellow-500/20 text-yellow-300 border-yellow-500/30',
  silver:   'bg-slate-400/20 text-slate-300 border-slate-400/30',
  bronze:   'bg-amber-700/20 text-amber-400 border-amber-700/30',
};

export default function AchievementsSection({ achievements }) {
  const [filter, setFilter] = useState('all');

  // Map badge_id → achievement record
  const earnedMap = {};
  achievements?.forEach(a => { earnedMap[a.badge_id] = a; });

  const earnedCount = achievements?.length || 0;
  const totalCount = BADGES.length;

  const sortedBadges = [...BADGES].sort((a, b) => {
    const aEarned = !!earnedMap[a.id];
    const bEarned = !!earnedMap[b.id];
    if (aEarned !== bEarned) return aEarned ? -1 : 1;
    return TIER_ORDER[b.tier] - TIER_ORDER[a.tier];
  });

  const filtered = filter === 'all' ? sortedBadges : sortedBadges.filter(b => b.tier === filter);

  return (
    <Card className="p-5 bg-card border-border">
      {/* Header */}
      <div className="flex items-center justify-between mb-4 flex-wrap gap-3">
        <div className="flex items-center gap-2">
          <Medal className="w-4 h-4 text-primary" />
          <h3 className="text-sm font-heading font-semibold">Achievements</h3>
          <Badge className="bg-primary/10 text-primary border-0 text-[10px] ml-1">
            {earnedCount} / {totalCount}
          </Badge>
        </div>

        {/* Progress bar */}
        <div className="flex-1 min-w-[120px] max-w-[200px]">
          <div className="h-1.5 rounded-full bg-secondary overflow-hidden">
            <div
              className="h-full rounded-full bg-gradient-to-r from-primary to-accent transition-all duration-700"
              style={{ width: `${(earnedCount / totalCount) * 100}%` }}
            />
          </div>
          <p className="text-[10px] text-muted-foreground mt-1 text-right">
            {Math.round((earnedCount / totalCount) * 100)}% complete
          </p>
        </div>
      </div>

      {/* Tier filter pills */}
      <div className="flex gap-1.5 mb-4 flex-wrap">
        {TIER_FILTERS.map(t => (
          <button
            key={t}
            onClick={() => setFilter(t)}
            className={cn(
              'px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider border transition-all',
              filter === t
                ? tierBadgeStyle[t]
                : 'border-transparent text-muted-foreground hover:text-foreground'
            )}
          >
            {t}
          </button>
        ))}
      </div>

      {/* Badge grid */}
      <div className="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2.5">
        {filtered.map(badge => (
          <BadgeCard
            key={badge.id}
            badge={badge}
            earned={!!earnedMap[badge.id]}
            earnedAt={earnedMap[badge.id]?.earned_at}
          />
        ))}
      </div>
    </Card>
  );
}

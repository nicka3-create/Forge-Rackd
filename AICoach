import React, { useState } from 'react';
import { base44 } from '@/api/base44Client';
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Textarea } from '@/components/ui/textarea';
import { Badge } from '@/components/ui/badge';
import { Sparkles, Send, Loader2, Dumbbell, Apple, Brain, Target } from 'lucide-react';
import ReactMarkdown from 'react-markdown';

const quickPrompts = [
  { icon: Dumbbell, label: 'Build a push/pull/legs split', prompt: 'Create a detailed 6-day push/pull/legs workout split for intermediate lifters focused on muscle hypertrophy. Include sets, reps, and rest periods.' },
  { icon: Apple, label: 'Meal plan for muscle gain', prompt: 'Create a 3000 calorie meal plan for muscle gain with high protein. Include breakfast, lunch, dinner and 2 snacks with macros.' },
  { icon: Brain, label: 'Break through a plateau', prompt: 'I\'ve been stuck at the same weight on bench press for 3 weeks. Give me strategies to break through this strength plateau.' },
  { icon: Target, label: 'Fat loss while keeping muscle', prompt: 'Design a training and nutrition strategy for losing fat while preserving muscle mass. I currently weigh 85kg at ~18% body fat.' },
];

export default function AICoach() {
  const [prompt, setPrompt] = useState('');
  const [response, setResponse] = useState('');
  const [loading, setLoading] = useState(false);
  const [history, setHistory] = useState([]);

  const askCoach = async (text) => {
    const question = text || prompt;
    if (!question.trim()) return;
    setLoading(true);
    setPrompt('');

    const result = await base44.integrations.Core.InvokeLLM({
      prompt: `You are Forge Rackd AI Coach — an expert fitness, nutrition, and strength coach. You're knowledgeable, motivating, and evidence-based. Provide detailed, actionable advice. Use markdown formatting with headers and bullet points. Be encouraging but realistic.\n\nUser's question: ${question}`,
    });

    setHistory(prev => [...prev, { question, answer: result }]);
    setResponse(result);
    setLoading(false);
  };

  return (
    <div className="space-y-6 max-w-3xl mx-auto">
      <div className="text-center">
        <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary to-accent flex items-center justify-center mx-auto mb-4">
          <Sparkles className="w-7 h-7 text-white" />
        </div>
        <h1 className="text-2xl font-heading font-bold">AI Coach</h1>
        <p className="text-sm text-muted-foreground mt-1">Your personal fitness, nutrition, and training advisor</p>
      </div>

      {/* Quick Prompts */}
      {history.length === 0 && (
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {quickPrompts.map(({ icon: Icon, label, prompt: p }) => (
            <Card 
              key={label}
              onClick={() => askCoach(p)}
              className="p-4 bg-card border-border hover:border-primary/30 cursor-pointer transition-all group"
            >
              <div className="flex items-start gap-3">
                <div className="w-8 h-8 rounded-lg bg-secondary flex items-center justify-center group-hover:bg-primary/10 transition-colors">
                  <Icon className="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" />
                </div>
                <span className="text-sm font-medium flex-1">{label}</span>
              </div>
            </Card>
          ))}
        </div>
      )}

      {/* History */}
      {history.map((item, i) => (
        <div key={i} className="space-y-3">
          <div className="flex justify-end">
            <div className="bg-primary text-primary-foreground rounded-2xl rounded-br-md px-4 py-2.5 max-w-[80%]">
              <p className="text-sm">{item.question}</p>
            </div>
          </div>
          <Card className="p-5 bg-card border-border">
            <div className="flex items-center gap-2 mb-3">
              <Sparkles className="w-4 h-4 text-primary" />
              <span className="text-xs font-semibold text-primary">AI COACH</span>
            </div>
            <div className="prose prose-sm prose-invert max-w-none text-sm leading-relaxed">
              <ReactMarkdown>{item.answer}</ReactMarkdown>
            </div>
          </Card>
        </div>
      ))}

      {loading && (
        <div className="flex items-center gap-3 p-4">
          <Loader2 className="w-5 h-5 animate-spin text-primary" />
          <span className="text-sm text-muted-foreground">Thinking...</span>
        </div>
      )}

      {/* Input */}
      <div className="sticky bottom-4">
        <Card className="p-3 bg-card border-border flex gap-2 items-end">
          <Textarea
            placeholder="Ask your AI coach anything about training, nutrition, recovery..."
            value={prompt}
            onChange={(e) => setPrompt(e.target.value)}
            onKeyDown={(e) => e.key === 'Enter' && !e.shiftKey && (e.preventDefault(), askCoach())}
            className="bg-secondary border-0 resize-none min-h-[40px] max-h-[120px] text-sm"
            rows={1}
          />
          <Button onClick={() => askCoach()} disabled={loading || !prompt.trim()} className="bg-primary hover:bg-primary/90 h-10 w-10 p-0 shrink-0">
            <Send className="w-4 h-4" />
          </Button>
        </Card>
      </div>
    </div>
  );
}

import React, { useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import { base44 } from '@/api/base44Client';
import { Card } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Dumbbell, Weight, Trophy, Loader2 } from 'lucide-react';
import { startOfWeek, endOfWeek, isWithinInterval, parseISO } from 'date-fns';

const TABS = [
  { key: 'workout_count', label: 'Workout Count', icon: Dumbbell, unit: 'workouts' },
  { key: 'volume_lifted', label: 'Volume Lifted', icon: Weight, unit: 'kg' },
];

const rankColors = ['text-yellow-400', 'text-slate-300', 'text-amber-600'];
const rankBg = ['bg-yellow-400/10 border-yellow-400/30', 'bg-slate-300/10 border-slate-300/30', 'bg-amber-600/10 border-amber-600/30'];

function computeLeaderboard(workouts, tab) {
  const now = new Date();
  const weekStart = startOfWeek(now, { weekStartsOn: 1 });
  const weekEnd = endOfWeek(now, { weekStartsOn: 1 });

  const weeklyWorkouts = workouts.filter(w => {
    try { return isWithinInterval(parseISO(w.date), { start: weekStart, end: weekEnd }); }
    catch { return false; }
  });

  const map = {};
  for (const w of weeklyWorkouts) {
    const email = w.created_by;
    if (!email) continue;
    if (!map[email]) map[email] = { email, workout_count: 0, volume_lifted: 0 };
    map[email].workout_count += 1;
    if (w.exercises) {
      for (const ex of w.exercises) {
        for (const set of (ex.sets || [])) {
          map[email].volume_lifted += (set.weight || 0) * (set.reps || 0);
        }
      }
    }
  }

  return Object.values(map)
    .sort((a, b) => b[tab] - a[tab])
    .slice(0, 10);
}

export default function WeeklyLeaderboard() {
  const [tab, setTab] = useState('workout_count');

  const { data: workouts, isLoading } = useQuery({
    queryKey: ['allWorkoutsLeaderboard'],
    queryFn: () => base44.entities.Workout.list('-date', 500),
    initialData: [],
  });

  const { data: profiles } = useQuery({
    queryKey: ['allProfiles'],
    queryFn: () => base44.entities.UserProfile.list(),
    initialData: [],
  });

  const profileMap = Object.fromEntries(profiles.map(p => [p.user_email, p]));
  const board = computeLeaderboard(workouts, tab);
  const activeTab = TABS.find(t => t.key === tab);

  return (
    <Card className="bg-card border-border p-4">
      <div className="flex items-center gap-2 mb-4">
        <Trophy className="w-4 h-4 text-yellow-400" />
        <h2 className="font-heading font-bold text-sm">Weekly Leaderboard</h2>
        <span className="text-xs text-muted-foreground ml-auto">This week</span>
      </div>

      {/* Tabs */}
      <div className="flex gap-1.5 mb-4">
        {TABS.map(t => (
          <button
            key={t.key}
            onClick={() => setTab(t.key)}
            className={`flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-md font-medium transition-colors ${
              tab === t.key ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground hover:text-foreground'
            }`}
          >
            <t.icon className="w-3 h-3" />
            {t.label}
          </button>
        ))}
      </div>

      {isLoading ? (
        <div className="flex justify-center py-8"><Loader2 className="w-5 h-5 animate-spin text-primary" /></div>
      ) : board.length === 0 ? (
        <p className="text-center text-xs text-muted-foreground py-8">No workouts logged this week yet. Be first! 💪</p>
      ) : (
        <div className="space-y-2">
          {board.map((entry, i) => {
            const profile = profileMap[entry.email];
            const displayName = profile?.display_name || entry.email.split('@')[0];
            const isTop3 = i < 3;
            return (
              <div
                key={entry.email}
                className={`flex items-center gap-3 px-3 py-2 rounded-lg border transition-colors ${
                  isTop3 ? rankBg[i] : 'border-transparent hover:bg-secondary/50'
                }`}
              >
                <span className={`text-sm font-bold w-5 text-center ${isTop3 ? rankColors[i] : 'text-muted-foreground'}`}>
                  {i + 1}
                </span>
                <div className="w-7 h-7 rounded-full bg-secondary flex items-center justify-center text-xs font-bold text-primary flex-shrink-0">
                  {displayName[0]?.toUpperCase()}
                </div>
                <span className="text-sm font-medium flex-1 truncate">{displayName}</span>
                <span className={`text-xs font-bold ${isTop3 ? rankColors[i] : 'text-muted-foreground'}`}>
                  {tab === 'volume_lifted'
                    ? `${(entry.volume_lifted / 1000).toFixed(1)}t`
                    : `${entry.workout_count} ${activeTab.unit}`}
                </span>
              </div>
            );
          })}
        </div>
      )}
    </Card>
  );
}

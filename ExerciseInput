import React from 'react';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Plus, Trash2, Trophy, X } from 'lucide-react';

export default function ExerciseInput({ exercise, exerciseIndex, onUpdate, onRemove }) {
  const updateExerciseName = (name) => {
    onUpdate({ ...exercise, name });
  };

  const addSet = () => {
    const sets = [...(exercise.sets || []), { reps: 0, weight: 0, is_pr: false }];
    onUpdate({ ...exercise, sets });
  };

  const updateSet = (setIndex, field, value) => {
    const sets = [...(exercise.sets || [])];
    sets[setIndex] = { ...sets[setIndex], [field]: field === 'is_pr' ? value : Number(value) };
    onUpdate({ ...exercise, sets });
  };

  const removeSet = (setIndex) => {
    const sets = exercise.sets.filter((_, i) => i !== setIndex);
    onUpdate({ ...exercise, sets });
  };

  return (
    <div className="bg-secondary/50 rounded-xl p-4">
      <div className="flex items-center gap-2 mb-3">
        <Input
          placeholder="Exercise name (e.g. Bench Press)"
          value={exercise.name || ''}
          onChange={(e) => updateExerciseName(e.target.value)}
          className="bg-background border-border h-9 text-sm font-medium"
        />
        <Button variant="ghost" size="icon" onClick={onRemove} className="text-muted-foreground hover:text-destructive h-9 w-9">
          <Trash2 className="w-4 h-4" />
        </Button>
      </div>

      {/* Sets */}
      <div className="space-y-2">
        {exercise.sets?.length > 0 && (
          <div className="grid grid-cols-[auto_1fr_1fr_auto_auto] gap-2 items-center text-[10px] text-muted-foreground uppercase tracking-wider px-1">
            <span>Set</span><span>Weight (kg)</span><span>Reps</span><span>PR</span><span></span>
          </div>
        )}
        {exercise.sets?.map((set, setIndex) => (
          <div key={setIndex} className="grid grid-cols-[auto_1fr_1fr_auto_auto] gap-2 items-center">
            <span className="text-xs text-muted-foreground w-6 text-center">{setIndex + 1}</span>
            <Input
              type="number"
              value={set.weight || ''}
              onChange={(e) => updateSet(setIndex, 'weight', e.target.value)}
              className="bg-background border-border h-8 text-xs"
              placeholder="0"
            />
            <Input
              type="number"
              value={set.reps || ''}
              onChange={(e) => updateSet(setIndex, 'reps', e.target.value)}
              className="bg-background border-border h-8 text-xs"
              placeholder="0"
            />
            <button
              onClick={() => updateSet(setIndex, 'is_pr', !set.is_pr)}
              className={`w-7 h-7 rounded-md flex items-center justify-center transition-colors ${set.is_pr ? 'bg-primary/20 text-primary' : 'bg-background text-muted-foreground hover:text-foreground'}`}
            >
              <Trophy className="w-3.5 h-3.5" />
            </button>
            <button onClick={() => removeSet(setIndex)} className="w-7 h-7 rounded-md flex items-center justify-center text-muted-foreground hover:text-destructive bg-background">
              <X className="w-3.5 h-3.5" />
            </button>
          </div>
        ))}
      </div>

      <Button variant="ghost" size="sm" onClick={addSet} className="mt-2 text-xs text-primary hover:text-primary/80 w-full">
        <Plus className="w-3 h-3 mr-1" /> Add Set
      </Button>
    </div>
  );
}

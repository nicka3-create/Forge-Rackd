import React from 'react';
import { base44 } from '@/api/base44Client';
import { useQuery, useQueryClient } from '@tanstack/react-query';
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Avatar, AvatarFallback } from '@/components/ui/avatar';
import { Users, UserPlus, UserMinus, Dumbbell, Trophy, Flame, Loader2 } from 'lucide-react';
import { toast } from 'sonner';

export default function Explore() {
  const queryClient = useQueryClient();

  const { data: user } = useQuery({ queryKey: ['currentUser'], queryFn: () => base44.auth.me() });
  const { data: profiles, isLoading } = useQuery({
    queryKey: ['allProfiles'],
    queryFn: () => base44.entities.UserProfile.list('-total_workouts', 50),
    initialData: [],
  });
  const { data: myProfileArr } = useQuery({
    queryKey: ['myProfile', user?.email],
    queryFn: () => base44.entities.UserProfile.filter({ user_email: user?.email }),
    enabled: !!user?.email,
  });

  const myProfile = myProfileArr?.[0];
  const otherProfiles = profiles.filter(p => p.user_email !== user?.email);

  const toggleFollow = async (profile) => {
    if (!myProfile) {
      toast.error('Create your profile first');
      return;
    }
    const isFollowing = myProfile.following?.includes(profile.user_email);
    const newFollowing = isFollowing
      ? myProfile.following.filter(e => e !== profile.user_email)
      : [...(myProfile.following || []), profile.user_email];
    const newFollowers = isFollowing
      ? (profile.followers || []).filter(e => e !== user?.email)
      : [...(profile.followers || []), user?.email];

    await Promise.all([
      base44.entities.UserProfile.update(myProfile.id, { following: newFollowing }),
      base44.entities.UserProfile.update(profile.id, { followers: newFollowers }),
    ]);
    queryClient.invalidateQueries({ queryKey: ['allProfiles'] });
    queryClient.invalidateQueries({ queryKey: ['myProfile'] });
    toast.success(isFollowing ? 'Unfollowed' : 'Following!');
  };

  const goalColors = {
    muscle_gain: 'bg-primary/10 text-primary',
    fat_loss: 'bg-accent/10 text-accent',
    strength: 'bg-chart-4/10 text-chart-4',
    endurance: 'bg-chart-3/10 text-chart-3',
    general_fitness: 'bg-secondary text-secondary-foreground',
  };

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-heading font-bold">Explore</h1>
        <p className="text-sm text-muted-foreground mt-1">Discover and connect with fellow athletes</p>
      </div>

      {isLoading ? (
        <div className="flex justify-center py-12"><Loader2 className="w-6 h-6 animate-spin text-primary" /></div>
      ) : otherProfiles.length === 0 ? (
        <div className="text-center py-16">
          <Users className="w-12 h-12 text-muted-foreground/30 mx-auto mb-3" />
          <p className="text-muted-foreground text-sm">No other users yet. Invite your gym buddies!</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {otherProfiles.map(profile => {
            const isFollowing = myProfile?.following?.includes(profile.user_email);
            return (
              <Card key={profile.id} className="bg-card border-border p-4">
                <div className="flex items-start gap-3">
                  <Avatar className="w-12 h-12">
                    <AvatarFallback className="bg-secondary font-bold">
                      {profile.display_name?.[0]?.toUpperCase() || '?'}
                    </AvatarFallback>
                  </Avatar>
                  <div className="flex-1 min-w-0">
                    <h3 className="font-semibold text-sm truncate">{profile.display_name}</h3>
                    {profile.bio && <p className="text-xs text-muted-foreground line-clamp-2 mt-0.5">{profile.bio}</p>}
                    <div className="flex items-center gap-2 mt-2 flex-wrap">
                      {profile.fitness_goal && (
                        <Badge className={`${goalColors[profile.fitness_goal] || goalColors.general_fitness} border-0 text-[10px] capitalize`}>
                          {profile.fitness_goal?.replace('_', ' ')}
                        </Badge>
                      )}
                      {profile.experience_level && (
                        <Badge variant="secondary" className="text-[10px] capitalize">{profile.experience_level}</Badge>
                      )}
                    </div>
                  </div>
                </div>

                <div className="grid grid-cols-3 gap-2 mt-4 mb-3">
                  <div className="text-center">
                    <Dumbbell className="w-3.5 h-3.5 text-muted-foreground mx-auto mb-0.5" />
                    <p className="text-xs font-bold">{profile.total_workouts || 0}</p>
                    <p className="text-[9px] text-muted-foreground">Workouts</p>
                  </div>
                  <div className="text-center">
                    <Trophy className="w-3.5 h-3.5 text-muted-foreground mx-auto mb-0.5" />
                    <p className="text-xs font-bold">{profile.total_prs || 0}</p>
                    <p className="text-[9px] text-muted-foreground">PRs</p>
                  </div>
                  <div className="text-center">
                    <Flame className="w-3.5 h-3.5 text-muted-foreground mx-auto mb-0.5" />
                    <p className="text-xs font-bold">{profile.streak_days || 0}</p>
                    <p className="text-[9px] text-muted-foreground">Streak</p>
                  </div>
                </div>

                <Button 
                  onClick={() => toggleFollow(profile)}
                  variant={isFollowing ? 'outline' : 'default'}
                  className={`w-full text-xs h-8 ${!isFollowing ? 'bg-primary hover:bg-primary/90' : ''}`}
                >
                  {isFollowing ? <><UserMinus className="w-3 h-3 mr-1" /> Unfollow</> : <><UserPlus className="w-3 h-3 mr-1" /> Follow</>}
                </Button>
              </Card>
            );
          })}
        </div>
      )}
    </div>
  );
}

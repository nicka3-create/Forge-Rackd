import React, { useState, useEffect } from 'react';
import { base44 } from '@/api/base44Client';
import { useQuery, useQueryClient } from '@tanstack/react-query';
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Avatar, AvatarFallback } from '@/components/ui/avatar';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Switch } from '@/components/ui/switch';
import { Label } from '@/components/ui/label';
import { 
  User, Edit2, Save, Dumbbell, Trophy, Flame, Users, 
  Target, BarChart3, Loader2, TrendingUp, Zap
} from 'lucide-react';
import { toast } from 'sonner';
import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer } from 'recharts';
import AchievementsSection from '@/components/profile/AchievementsSection';
import { checkAndAwardBadges } from '@/hooks/useAchievements';

export default function Profile() {
  const [editing, setEditing] = useState(false);
  const [form, setForm] = useState({});
  const queryClient = useQueryClient();

  const { data: user } = useQuery({ queryKey: ['currentUser'], queryFn: () => base44.auth.me() });
  const { data: profileArr, isLoading } = useQuery({
    queryKey: ['myProfile', user?.email],
    queryFn: () => base44.entities.UserProfile.filter({ user_email: user?.email }),
    enabled: !!user?.email,
  });
  const { data: workouts } = useQuery({
    queryKey: ['workouts'],
    queryFn: () => base44.entities.Workout.list('-date', 100),
    initialData: [],
  });

  const { data: myPosts } = useQuery({
    queryKey: ['myPosts', user?.email],
    queryFn: () => base44.entities.Post.filter({ created_by: user?.email }),
    enabled: !!user?.email,
    initialData: [],
  });

  const { data: achievements, refetch: refetchAchievements } = useQuery({
    queryKey: ['achievements', user?.email],
    queryFn: () => base44.entities.Achievement.filter({ user_email: user?.email }),
    enabled: !!user?.email,
    initialData: [],
  });

  const profile = profileArr?.[0];

  useEffect(() => {
    if (profile) setForm(profile);
  }, [profile]);

  // Auto-check achievements when profile loads
  useEffect(() => {
    if (!user?.email || !profile || workouts.length === 0) return;
    checkAndAwardBadges(user.email, workouts, myPosts || [], profile, achievements || [])
      .then(newIds => { if (newIds.length > 0) refetchAchievements(); });
  }, [user?.email, profile?.id, workouts.length]);

  const saveProfile = async () => {
    const data = {
      display_name: form.display_name || user?.full_name || 'Athlete',
      bio: form.bio || '',
      fitness_goal: form.fitness_goal || 'general_fitness',
      experience_level: form.experience_level || 'beginner',
      height_cm: form.height_cm || 0,
      weight_kg: form.weight_kg || 0,
      body_fat_pct: form.body_fat_pct || 0,
      is_coach: form.is_coach || false,
      user_email: user?.email,
    };

    if (profile) {
      await base44.entities.UserProfile.update(profile.id, data);
    } else {
      await base44.entities.UserProfile.create({
        ...data,
        following: [],
        followers: [],
        total_workouts: 0,
        total_prs: 0,
        streak_days: 0,
        communities: [],
      });
    }
    queryClient.invalidateQueries({ queryKey: ['myProfile'] });
    setEditing(false);
    toast.success('Profile saved!');
  };

  // Chart data from workouts
  const chartData = workouts.slice(0, 14).reverse().map(w => ({
    date: w.date?.slice(5) || '',
    volume: w.exercises?.reduce((t, ex) => t + (ex.sets?.reduce((s, set) => s + (set.weight || 0) * (set.reps || 0), 0) || 0), 0) || 0,
  }));

  if (isLoading) {
    return <div className="flex justify-center py-12"><Loader2 className="w-6 h-6 animate-spin text-primary" /></div>;
  }

  return (
    <div className="space-y-6 max-w-3xl mx-auto">
      {/* Header Card */}
      <Card className="bg-card border-border overflow-hidden">
        <div className="h-24 bg-gradient-to-r from-primary/20 via-accent/10 to-card" />
        <div className="px-5 pb-5 -mt-10">
          <div className="flex items-end gap-4">
            <Avatar className="w-20 h-20 border-4 border-card">
              <AvatarFallback className="bg-secondary text-2xl font-bold font-heading">
                {(profile?.display_name || user?.full_name || '?')[0]?.toUpperCase()}
              </AvatarFallback>
            </Avatar>
            <div className="flex-1 min-w-0 pb-1">
              <h1 className="text-xl font-heading font-bold truncate">
                {profile?.display_name || user?.full_name || 'New Athlete'}
              </h1>
              <p className="text-xs text-muted-foreground">{user?.email}</p>
            </div>
            <Button 
              variant="outline" size="sm" 
              onClick={() => editing ? saveProfile() : setEditing(true)}
              className="text-xs"
            >
              {editing ? <><Save className="w-3 h-3 mr-1" /> Save</> : <><Edit2 className="w-3 h-3 mr-1" /> Edit</>}
            </Button>
          </div>

          {/* Stats */}
          <div className="grid grid-cols-4 gap-3 mt-5">
            {[
              { icon: Dumbbell, value: workouts.length, label: 'Workouts' },
              { icon: Trophy, value: profile?.total_prs || 0, label: 'PRs' },
              { icon: Zap, value: profile?.streak_days || 0, label: 'Streak' },
              { icon: Users, value: profile?.followers?.length || 0, label: 'Followers' },
            ].map(({ icon: Icon, value, label }) => (
              <div key={label} className="text-center p-3 rounded-xl bg-secondary">
                <Icon className="w-4 h-4 text-muted-foreground mx-auto mb-1" />
                <p className="text-lg font-bold font-heading">{value}</p>
                <p className="text-[10px] text-muted-foreground uppercase tracking-wider">{label}</p>
              </div>
            ))}
          </div>
        </div>
      </Card>

      {/* Edit Form / Bio */}
      {editing ? (
        <Card className="p-5 bg-card border-border space-y-4">
          <h2 className="font-heading font-bold text-sm">Edit Profile</h2>
          <Input placeholder="Display name" value={form.display_name || ''} onChange={(e) => setForm(prev => ({ ...prev, display_name: e.target.value }))} className="bg-secondary border-0" />
          <Textarea placeholder="Bio" value={form.bio || ''} onChange={(e) => setForm(prev => ({ ...prev, bio: e.target.value }))} className="bg-secondary border-0 resize-none" />
          <div className="grid grid-cols-2 gap-3">
            <Select value={form.fitness_goal || 'general_fitness'} onValueChange={(v) => setForm(prev => ({ ...prev, fitness_goal: v }))}>
              <SelectTrigger className="bg-secondary border-0 text-xs"><SelectValue placeholder="Goal" /></SelectTrigger>
              <SelectContent>
                {['muscle_gain', 'fat_loss', 'strength', 'endurance', 'general_fitness'].map(g => (
                  <SelectItem key={g} value={g} className="text-xs capitalize">{g.replace('_', ' ')}</SelectItem>
                ))}
              </SelectContent>
            </Select>
            <Select value={form.experience_level || 'beginner'} onValueChange={(v) => setForm(prev => ({ ...prev, experience_level: v }))}>
              <SelectTrigger className="bg-secondary border-0 text-xs"><SelectValue placeholder="Level" /></SelectTrigger>
              <SelectContent>
                {['beginner', 'intermediate', 'advanced', 'elite'].map(l => (
                  <SelectItem key={l} value={l} className="text-xs capitalize">{l}</SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
          <div className="grid grid-cols-3 gap-3">
            <Input type="number" placeholder="Height (cm)" value={form.height_cm || ''} onChange={(e) => setForm(prev => ({ ...prev, height_cm: Number(e.target.value) }))} className="bg-secondary border-0 text-xs" />
            <Input type="number" placeholder="Weight (kg)" value={form.weight_kg || ''} onChange={(e) => setForm(prev => ({ ...prev, weight_kg: Number(e.target.value) }))} className="bg-secondary border-0 text-xs" />
            <Input type="number" placeholder="Body fat %" value={form.body_fat_pct || ''} onChange={(e) => setForm(prev => ({ ...prev, body_fat_pct: Number(e.target.value) }))} className="bg-secondary border-0 text-xs" />
          </div>
          <div className="flex items-center gap-3">
            <Switch checked={form.is_coach || false} onCheckedChange={(v) => setForm(prev => ({ ...prev, is_coach: v }))} />
            <Label className="text-sm">I'm a coach</Label>
          </div>
        </Card>
      ) : profile?.bio ? (
        <Card className="p-4 bg-card border-border">
          <p className="text-sm text-muted-foreground leading-relaxed">{profile.bio}</p>
          <div className="flex gap-2 mt-3">
            {profile.fitness_goal && <Badge className="bg-primary/10 text-primary border-0 text-xs capitalize">{profile.fitness_goal.replace('_', ' ')}</Badge>}
            {profile.experience_level && <Badge variant="secondary" className="text-xs capitalize">{profile.experience_level}</Badge>}
            {profile.is_coach && <Badge className="bg-accent/10 text-accent border-0 text-xs">Coach</Badge>}
          </div>
        </Card>
      ) : null}

      {/* Achievements */}
      <AchievementsSection achievements={achievements} />

      {/* Volume Chart */}
      {chartData.length > 1 && (
        <Card className="p-5 bg-card border-border">
          <div className="flex items-center gap-2 mb-4">
            <TrendingUp className="w-4 h-4 text-primary" />
            <h3 className="text-sm font-heading font-semibold">Training Volume</h3>
          </div>
          <ResponsiveContainer width="100%" height={180}>
            <LineChart data={chartData}>
              <XAxis dataKey="date" tick={{ fontSize: 10, fill: 'hsl(220, 10%, 55%)' }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 10, fill: 'hsl(220, 10%, 55%)' }} axisLine={false} tickLine={false} width={40} />
              <Tooltip 
                contentStyle={{ background: 'hsl(220, 15%, 9%)', border: '1px solid hsl(220, 15%, 16%)', borderRadius: '8px', fontSize: '12px' }}
                labelStyle={{ color: 'hsl(210, 20%, 95%)' }}
              />
              <Line type="monotone" dataKey="volume" stroke="hsl(25, 95%, 55%)" strokeWidth={2} dot={{ r: 3, fill: 'hsl(25, 95%, 55%)' }} />
            </LineChart>
          </ResponsiveContainer>
        </Card>
      )}
    </div>
  );
}

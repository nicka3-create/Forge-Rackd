import React, { useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import { base44 } from '@/api/base44Client';
import { Card } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Dumbbell, Weight, Trophy, Loader2, Flame, Medal, Crown } from 'lucide-react';
import { startOfWeek, endOfWeek, isWithinInterval, parseISO, subWeeks } from 'date-fns';

const TABS = [
  { key: 'volume', label: 'Volume Lifted', icon: Weight, description: 'Total kg moved this week' },
  { key: 'workouts', label: 'Workout Count', icon: Dumbbell, description: 'Sessions completed this week' },
  { key: 'prs', label: 'PRs Set', icon: Trophy, description: 'Personal records this week' },
];

const rankColors = ['text-yellow-400', 'text-slate-300', 'text-amber-500'];
const rankBg = ['bg-yellow-400/10 border-yellow-400/20', 'bg-slate-300/10 border-slate-300/20', 'bg-amber-500/10 border-amber-500/20'];
const rankIcons = [Crown, Medal, Medal];

function computeLeaderboard(workouts, tab) {
  const now = new Date();
  const weekStart = startOfWeek(now, { weekStartsOn: 1 });
  const weekEnd = endOfWeek(now, { weekStartsOn: 1 });
  const prevWeekStart = startOfWeek(subWeeks(now, 1), { weekStartsOn: 1 });
  const prevWeekEnd = endOfWeek(subWeeks(now, 1), { weekStartsOn: 1 });

  const map = {};
  const prevMap = {};

  for (const w of workouts) {
    if (!w.created_by) continue;
    const email = w.created_by;
    let date;
    try { date = parseISO(w.date); } catch { continue; }

    const isThisWeek = isWithinInterval(date, { start: weekStart, end: weekEnd });
    const isLastWeek = isWithinInterval(date, { start: prevWeekStart, end: prevWeekEnd });

    const volume = w.exercises?.reduce((t, ex) =>
      t + (ex.sets?.reduce((s, set) => s + (set.weight || 0) * (set.reps || 0), 0) || 0), 0) || 0;
    const prs = w.exercises?.reduce((c, ex) =>
      c + (ex.sets?.filter(s => s.is_pr).length || 0), 0) || 0;

    if (isThisWeek) {
      if (!map[email]) map[email] = { email, volume: 0, workouts: 0, prs: 0 };
      map[email].volume += volume;
      map[email].workouts += 1;
      map[email].prs += prs;
    }
    if (isLastWeek) {
      if (!prevMap[email]) prevMap[email] = { volume: 0, workouts: 0, prs: 0 };
      prevMap[email].volume += volume;
      prevMap[email].workouts += 1;
      prevMap[email].prs += prs;
    }
  }

  const sorted = Object.values(map).sort((a, b) => b[tab] - a[tab]);
  // add rank change vs last week
  const prevSorted = Object.values(prevMap).sort((a, b) => b[tab] - a[tab]);
  const prevRankMap = Object.fromEntries(prevSorted.map((e, i) => [e.email, i + 1]));

  return sorted.map((entry, i) => ({
    ...entry,
    rank: i + 1,
    prevRank: prevRankMap[entry.email] || null,
  }));
}

function RankChange({ rank, prevRank }) {
  if (!prevRank) return <span className="text-xs text-primary font-semibold">NEW</span>;
  const diff = prevRank - rank;
  if (diff === 0) return <span className="text-xs text-muted-foreground">—</span>;
  return (
    <span className={`text-xs font-semibold flex items-center gap-0.5 ${diff > 0 ? 'text-green-400' : 'text-red-400'}`}>
      {diff > 0 ? '▲' : '▼'} {Math.abs(diff)}
    </span>
  );
}

export default function FullLeaderboard() {
  const [tab, setTab] = useState('volume');

  const { data: workouts, isLoading: loadingWorkouts } = useQuery({
    queryKey: ['allWorkoutsLeaderboard'],
    queryFn: () => base44.entities.Workout.list('-date', 500),
    initialData: [],
  });

  const { data: profiles, isLoading: loadingProfiles } = useQuery({
    queryKey: ['allProfiles'],
    queryFn: () => base44.entities.UserProfile.list(),
    initialData: [],
  });

  const profileMap = Object.fromEntries(profiles.map(p => [p.user_email, p]));
  const board = computeLeaderboard(workouts, tab);
  const activeTab = TABS.find(t => t.key === tab);
  const isLoading = loadingWorkouts || loadingProfiles;

  const top3 = board.slice(0, 3);
  const rest = board.slice(3);

  const formatValue = (entry) => {
    if (tab === 'volume') return `${(entry.volume / 1000).toFixed(2)}t`;
    if (tab === 'workouts') return `${entry.workouts} sessions`;
    return `${entry.prs} PRs`;
  };

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-xl font-heading font-bold flex items-center gap-2">
            <Trophy className="w-5 h-5 text-yellow-400" /> Weekly Leaderboard
          </h2>
          <p className="text-sm text-muted-foreground mt-0.5">Rankings reset every Monday · {activeTab?.description}</p>
        </div>
      </div>

      {/* Tab switcher */}
      <div className="flex gap-2 flex-wrap">
        {TABS.map(t => (
          <button
            key={t.key}
            onClick={() => setTab(t.key)}
            className={`flex items-center gap-2 text-sm px-4 py-2 rounded-xl font-medium transition-all ${
              tab === t.key
                ? 'bg-primary text-primary-foreground shadow-lg shadow-primary/20'
                : 'bg-secondary text-muted-foreground hover:text-foreground hover:bg-secondary/80'
            }`}
          >
            <t.icon className="w-4 h-4" />
            {t.label}
          </button>
        ))}
      </div>

      {isLoading ? (
        <div className="flex justify-center py-16"><Loader2 className="w-6 h-6 animate-spin text-primary" /></div>
      ) : board.length === 0 ? (
        <Card className="bg-card border-border p-12 text-center">
          <Dumbbell className="w-12 h-12 text-muted-foreground/20 mx-auto mb-3" />
          <p className="font-semibold text-sm">No activity this week yet</p>
          <p className="text-xs text-muted-foreground mt-1">Log a workout to appear on the leaderboard! 💪</p>
        </Card>
      ) : (
        <>
          {/* Top 3 podium */}
          {top3.length > 0 && (
            <div className="grid grid-cols-3 gap-3">
              {[top3[1], top3[0], top3[2]].filter(Boolean).map((entry, idx) => {
                // reorder so 2nd is left, 1st center, 3rd right
                const realIdx = entry.rank - 1;
                const RankIcon = rankIcons[realIdx];
                const profile = profileMap[entry.email];
                const displayName = profile?.display_name || entry.email.split('@')[0];
                const isFirst = entry.rank === 1;
                return (
                  <Card
                    key={entry.email}
                    className={`border p-4 text-center flex flex-col items-center gap-2 transition-all ${
                      rankBg[realIdx]
                    } ${isFirst ? 'scale-105 shadow-lg shadow-primary/10' : ''}`}
                  >
                    <RankIcon className={`w-5 h-5 ${rankColors[realIdx]}`} />
                    <div className={`w-12 h-12 rounded-full bg-secondary/80 flex items-center justify-center text-lg font-bold ${rankColors[realIdx]}`}>
                      {displayName[0]?.toUpperCase()}
                    </div>
                    <div>
                      <p className="font-semibold text-xs truncate max-w-[80px]">{displayName}</p>
                      <p className={`text-sm font-bold mt-0.5 ${rankColors[realIdx]}`}>{formatValue(entry)}</p>
                    </div>
                    <Badge className={`text-[9px] border ${rankBg[realIdx]} ${rankColors[realIdx]}`}>
                      #{entry.rank}
                    </Badge>
                  </Card>
                );
              })}
            </div>
          )}

          {/* Full list */}
          <Card className="bg-card border-border overflow-hidden">
            <div className="p-4 border-b border-border">
              <div className="grid grid-cols-12 text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">
                <span className="col-span-1 text-center">Rank</span>
                <span className="col-span-5 pl-3">Athlete</span>
                <span className="col-span-3 text-right">{tab === 'volume' ? 'Volume' : tab === 'workouts' ? 'Sessions' : 'PRs'}</span>
                <span className="col-span-3 text-right pr-2">Change</span>
              </div>
            </div>
            <div className="divide-y divide-border">
              {board.map((entry, i) => {
                const profile = profileMap[entry.email];
                const displayName = profile?.display_name || entry.email.split('@')[0];
                const isTop3 = i < 3;
                return (
                  <div
                    key={entry.email}
                    className={`grid grid-cols-12 items-center px-4 py-3 transition-colors hover:bg-secondary/30 ${
                      isTop3 ? 'bg-secondary/20' : ''
                    }`}
                  >
                    <span className={`col-span-1 text-sm font-bold text-center ${isTop3 ? rankColors[i] : 'text-muted-foreground'}`}>
                      {i + 1}
                    </span>
                    <div className="col-span-5 flex items-center gap-2.5 pl-2">
                      <div className={`w-8 h-8 rounded-full bg-secondary flex items-center justify-center text-xs font-bold flex-shrink-0 ${isTop3 ? rankColors[i] : 'text-primary'}`}>
                        {displayName[0]?.toUpperCase()}
                      </div>
                      <div className="min-w-0">
                        <p className="text-sm font-medium truncate">{displayName}</p>
                        {profile?.fitness_goal && (
                          <p className="text-[10px] text-muted-foreground capitalize">{profile.fitness_goal.replace('_', ' ')}</p>
                        )}
                      </div>
                    </div>
                    <div className="col-span-3 text-right">
                      <span className={`text-sm font-bold ${isTop3 ? rankColors[i] : 'text-foreground'}`}>
                        {formatValue(entry)}
                      </span>
                    </div>
                    <div className="col-span-3 text-right pr-1">
                      <RankChange rank={entry.rank} prevRank={entry.prevRank} />
                    </div>
                  </div>
                );
              })}
            </div>
          </Card>
        </>
      )}
    </div>
  );
}

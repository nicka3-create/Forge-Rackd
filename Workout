{
  "name": "Workout",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Workout name"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "duration_minutes": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "strength",
        "cardio",
        "hiit",
        "flexibility",
        "crossfit",
        "powerlifting",
        "bodybuilding",
        "other"
      ]
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reps": {
                  "type": "number"
                },
                "weight": {
                  "type": "number"
                },
                "is_pr": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "calories_burned": {
      "type": "number"
    },
    "mood": {
      "type": "string",
      "enum": [
        "amazing",
        "good",
        "neutral",
        "tired",
        "exhausted"
      ]
    }
  },
  "required": [
    "title",
    "date"
  ]
}

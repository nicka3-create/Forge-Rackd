// ── HELPER FUNCTIONS ──────────────────────────────────────────────

function _longestStreak(workouts) {
  if (!workouts.length) return 0;
  const dates = [...new Set(workouts.map(w => w.date).filter(Boolean))].sort();
  let max = 1, cur = 1;
  for (let i = 1; i < dates.length; i++) {
    const prev = new Date(dates[i - 1]);
    const curr = new Date(dates[i]);
    const diff = (curr - prev) / (1000 * 60 * 60 * 24);
    if (diff === 1) { cur++; max = Math.max(max, cur); }
    else cur = 1;
  }
  return max;
}

function _tenInTen(workouts) {
  if (workouts.length < 10) return false;
  const dates = workouts.map(w => w.date).filter(Boolean).sort();
  for (let i = 9; i < dates.length; i++) {
    const start = new Date(dates[i - 9]);
    const end = new Date(dates[i]);
    const daySpan = (end - start) / (1000 * 60 * 60 * 24);
    if (daySpan <= 9) return true;
  }
  return false;
}

function _totalPRs(workouts) {
  return workouts.reduce((count, w) =>
    count + (w.exercises?.reduce((c, ex) =>
      c + (ex.sets?.filter(s => s.is_pr).length || 0), 0) || 0), 0);
}

function _totalVolume(workouts) {
  return workouts.reduce((total, w) =>
    total + (w.exercises?.reduce((t, ex) =>
      t + (ex.sets?.reduce((s, set) => s + (set.weight || 0) * (set.reps || 0), 0) || 0), 0) || 0), 0);
}

/**
 * Evaluate which badges a user has earned.
 * Returns array of badge ids that should be awarded.
 */
export function evaluateBadges(workouts, posts, profile) {
  return BADGES.filter(b => b.check(workouts, posts, profile)).map(b => b.id);
}

/**
 * Given currently stored achievement badge_ids, return new ones not yet stored.
 */
export function getNewlyEarnedBadges(earnedIds, workouts, posts, profile) {
  const allEarned = evaluateBadges(workouts, posts, profile);
  return allEarned.filter(id => !earnedIds.includes(id));
}


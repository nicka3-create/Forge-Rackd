import React, { useState } from 'react';
import { base44 } from '@/api/base44Client';
import { useQuery, useQueryClient } from '@tanstack/react-query';
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from '@/components/ui/dialog';
import { Users, Plus, Loader2, UserPlus, UserMinus, Trophy, Swords } from 'lucide-react';
import { toast } from 'sonner';
import ChallengesSection from '@/components/community/ChallengesSection';
import FullLeaderboard from '@/components/community/FullLeaderboard';

const categories = ['bodybuilding', 'powerlifting', 'fat_loss', 'crossfit', 'calisthenics', 'running', 'general'];
const categoryImages = {
  bodybuilding: 'https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?w=400&h=200&fit=crop',
  powerlifting: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=400&h=200&fit=crop',
  fat_loss: 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=400&h=200&fit=crop',
  crossfit: 'https://images.unsplash.com/photo-1526506118085-60ce8714f8c5?w=400&h=200&fit=crop',
  calisthenics: 'https://images.unsplash.com/photo-1598971639058-fab3c3109a00?w=400&h=200&fit=crop',
  running: 'https://images.unsplash.com/photo-1461896836934-bd45ba8df005?w=400&h=200&fit=crop',
  general: 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=400&h=200&fit=crop',
};

const COMMUNITY_TABS = [
  { key: 'communities', label: 'Communities', icon: Users },
  { key: 'leaderboard', label: 'Leaderboard', icon: Trophy },
  { key: 'challenges', label: 'Challenges', icon: Swords },
];

export default function Communities() {
  const [activeTab, setActiveTab] = useState('communities');
  const [newCommunity, setNewCommunity] = useState({ name: '', description: '', category: 'general' });
  const [dialogOpen, setDialogOpen] = useState(false);
  const queryClient = useQueryClient();

  const { data: user } = useQuery({ queryKey: ['currentUser'], queryFn: () => base44.auth.me() });
  const { data: communities, isLoading } = useQuery({
    queryKey: ['communities'],
    queryFn: () => base44.entities.Community.list('-member_count', 50),
    initialData: [],
  });

  const createCommunity = async () => {
    if (!newCommunity.name) return;
    await base44.entities.Community.create({
      ...newCommunity,
      members: [user?.email],
      member_count: 1,
    });
    queryClient.invalidateQueries({ queryKey: ['communities'] });
    setNewCommunity({ name: '', description: '', category: 'general' });
    setDialogOpen(false);
    toast.success('Community created!');
  };

  const toggleMembership = async (community) => {
    const isMember = community.members?.includes(user?.email);
    const newMembers = isMember
      ? community.members.filter(e => e !== user?.email)
      : [...(community.members || []), user?.email];
    await base44.entities.Community.update(community.id, {
      members: newMembers,
      member_count: newMembers.length,
    });
    queryClient.invalidateQueries({ queryKey: ['communities'] });
    toast.success(isMember ? 'Left community' : 'Joined community!');
  };

  return (
    <div className="space-y-6">
      {/* Page header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-heading font-bold">Community</h1>
          <p className="text-sm text-muted-foreground mt-1">Compete, connect, and grow together</p>
        </div>
        {activeTab === 'communities' && (
          <Dialog open={dialogOpen} onOpenChange={setDialogOpen}>
            <DialogTrigger asChild>
              <Button className="bg-primary hover:bg-primary/90"><Plus className="w-4 h-4 mr-1.5" /> Create</Button>
            </DialogTrigger>
            <DialogContent className="bg-card border-border">
              <DialogHeader><DialogTitle className="font-heading">Create Community</DialogTitle></DialogHeader>
              <div className="space-y-3 mt-2">
                <Input placeholder="Community name" value={newCommunity.name} onChange={(e) => setNewCommunity(prev => ({ ...prev, name: e.target.value }))} className="bg-secondary border-0" />
                <Textarea placeholder="Description" value={newCommunity.description} onChange={(e) => setNewCommunity(prev => ({ ...prev, description: e.target.value }))} className="bg-secondary border-0 resize-none" />
                <Select value={newCommunity.category} onValueChange={(v) => setNewCommunity(prev => ({ ...prev, category: v }))}>
                  <SelectTrigger className="bg-secondary border-0"><SelectValue /></SelectTrigger>
                  <SelectContent>
                    {categories.map(c => <SelectItem key={c} value={c} className="capitalize">{c.replace('_', ' ')}</SelectItem>)}
                  </SelectContent>
                </Select>
                <Button onClick={createCommunity} className="w-full bg-primary hover:bg-primary/90">Create Community</Button>
              </div>
            </DialogContent>
          </Dialog>
        )}
      </div>

      {/* Tab bar */}
      <div className="flex gap-1.5 border-b border-border pb-0">
        {COMMUNITY_TABS.map(t => (
          <button
            key={t.key}
            onClick={() => setActiveTab(t.key)}
            className={`flex items-center gap-2 text-sm px-4 py-2.5 font-medium transition-all border-b-2 -mb-px ${
              activeTab === t.key
                ? 'border-primary text-primary'
                : 'border-transparent text-muted-foreground hover:text-foreground'
            }`}
          >
            <t.icon className="w-4 h-4" />
            {t.label}
          </button>
        ))}
      </div>

      {/* Tab content */}
      {activeTab === 'leaderboard' && <FullLeaderboard />}

      {activeTab === 'challenges' && <ChallengesSection user={user} />}

      {activeTab === 'communities' && (
        isLoading ? (
          <div className="flex justify-center py-12"><Loader2 className="w-6 h-6 animate-spin text-primary" /></div>
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {communities.map(community => {
              const isMember = community.members?.includes(user?.email);
              return (
                <Card key={community.id} className="bg-card border-border overflow-hidden group">
                  <div className="h-28 bg-secondary relative overflow-hidden">
                    <img
                      src={community.cover_image || categoryImages[community.category] || categoryImages.general}
                      alt=""
                      className="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity"
                    />
                    <div className="absolute inset-0 bg-gradient-to-t from-card/90 to-transparent" />
                    <Badge className="absolute top-3 right-3 bg-background/60 backdrop-blur-sm border-0 text-[10px] capitalize">
                      {community.category?.replace('_', ' ')}
                    </Badge>
                  </div>
                  <div className="p-4 -mt-6 relative">
                    <h3 className="font-heading font-bold text-sm">{community.name}</h3>
                    <p className="text-xs text-muted-foreground mt-1 line-clamp-2">{community.description || 'No description'}</p>
                    <div className="flex items-center justify-between mt-3">
                      <span className="text-xs text-muted-foreground flex items-center gap-1">
                        <Users className="w-3 h-3" /> {community.member_count || 0} members
                      </span>
                      <Button
                        size="sm"
                        variant={isMember ? 'outline' : 'default'}
                        onClick={() => toggleMembership(community)}
                        className={`text-xs h-7 ${!isMember ? 'bg-primary hover:bg-primary/90' : ''}`}
                      >
                        {isMember ? <><UserMinus className="w-3 h-3 mr-1" /> Leave</> : <><UserPlus className="w-3 h-3 mr-1" /> Join</>}
                      </Button>
                    </div>
                  </div>
                </Card>
              );
            })}
          </div>
        )
      )}
    </div>
  );
}

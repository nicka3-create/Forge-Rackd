{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "fitness_goal": {
      "type": "string",
      "enum": [
        "muscle_gain",
        "fat_loss",
        "strength",
        "endurance",
        "general_fitness"
      ]
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "elite"
      ]
    },
    "height_cm": {
      "type": "number"
    },
    "weight_kg": {
      "type": "number"
    },
    "body_fat_pct": {
      "type": "number"
    },
    "following": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users being followed"
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of followers"
    },
    "total_workouts": {
      "type": "number",
      "default": 0
    },
    "total_prs": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "is_coach": {
      "type": "boolean",
      "default": false
    },
    "communities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_email",
    "display_name"
  ]
}

import React, { useState } from 'react';
import { base44 } from '@/api/base44Client';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from '@/components/ui/dialog';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Plus } from 'lucide-react';
import { toast } from 'sonner';
import { format } from 'date-fns';

const FIELDS = [
  { key: 'weight_kg', label: 'Weight', unit: 'kg', placeholder: '75.0' },
  { key: 'body_fat_pct', label: 'Body Fat', unit: '%', placeholder: '18.0' },
  { key: 'chest_cm', label: 'Chest', unit: 'cm', placeholder: '100' },
  { key: 'waist_cm', label: 'Waist', unit: 'cm', placeholder: '82' },
  { key: 'hips_cm', label: 'Hips', unit: 'cm', placeholder: '97' },
  { key: 'arms_cm', label: 'Arms', unit: 'cm', placeholder: '36' },
  { key: 'thighs_cm', label: 'Thighs', unit: 'cm', placeholder: '58' },
  { key: 'shoulders_cm', label: 'Shoulders', unit: 'cm', placeholder: '120' },
];

export default function LogStatDialog({ user, onSaved }) {
  const [open, setOpen] = useState(false);
  const [saving, setSaving] = useState(false);
  const [form, setForm] = useState({ date: format(new Date(), 'yyyy-MM-dd'), notes: '' });

  const set = (key, val) => setForm(prev => ({ ...prev, [key]: val }));

  const handleSave = async () => {
    const hasData = FIELDS.some(f => form[f.key] !== undefined && form[f.key] !== '');
    if (!hasData) { toast.error('Enter at least one measurement'); return; }
    setSaving(true);
    const payload = { user_email: user.email, date: form.date, notes: form.notes };
    FIELDS.forEach(f => { if (form[f.key] !== '' && form[f.key] !== undefined) payload[f.key] = Number(form[f.key]); });
    await base44.entities.BodyStat.create(payload);
    toast.success('Stats logged! 📊');
    setOpen(false);
    setSaving(false);
    setForm({ date: format(new Date(), 'yyyy-MM-dd'), notes: '' });
    onSaved?.();
  };

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        <Button className="bg-primary hover:bg-primary/90"><Plus className="w-4 h-4 mr-1.5" /> Log Stats</Button>
      </DialogTrigger>
      <DialogContent className="bg-card border-border max-w-sm max-h-[90vh] overflow-y-auto">
        <DialogHeader><DialogTitle className="font-heading">Log Body Stats</DialogTitle></DialogHeader>
        <div className="space-y-3 mt-1">
          <div>
            <label className="text-xs text-muted-foreground mb-1 block">Date</label>
            <Input type="date" value={form.date} onChange={e => set('date', e.target.value)} className="bg-secondary border-0" />
          </div>
          <div className="grid grid-cols-2 gap-2">
            {FIELDS.map(f => (
              <div key={f.key}>
                <label className="text-xs text-muted-foreground mb-1 block">{f.label} ({f.unit})</label>
                <Input
                  type="number"
                  step="0.1"
                  placeholder={f.placeholder}
                  value={form[f.key] ?? ''}
                  onChange={e => set(f.key, e.target.value)}
                  className="bg-secondary border-0 text-sm"
                />
              </div>
            ))}
          </div>
          <Textarea
            placeholder="Notes (optional)"
            value={form.notes}
            onChange={e => set('notes', e.target.value)}
            className="bg-secondary border-0 resize-none h-14 text-sm"
          />
          <Button onClick={handleSave} disabled={saving} className="w-full bg-primary hover:bg-primary/90">
            {saving ? 'Saving…' : 'Save Entry'}
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}
